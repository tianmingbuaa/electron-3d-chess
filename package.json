{
  "name": "nocturne-chess",
  "version": "1.0.0",
  "private": true,
  "description": "Nocturne Chess — an elegant 3D chess game built with Electron, React and Three.js",
  "author": "Nocturne Atelier",
  "license": "MIT",
  "main": "apps/desktop/dist/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first -n backend,web,desktop -c \"#7dd3fc,#fbbf24,#c4b5fd\" \"pnpm --filter @nocturne/chess-server dev\" \"pnpm --filter @nocturne/chess-web dev\" \"wait-on tcp:8787 http://127.0.0.1:5173 && pnpm build:desktop && cross-env CHESS_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "pnpm run build:web && pnpm run build:desktop",
    "build:server": "pnpm --filter @nocturne/chess-server build",
    "build:web": "pnpm --filter @nocturne/chess-web build",
    "build:desktop": "pnpm build:server && pnpm --filter @nocturne/chess-desktop build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dist": "pnpm run build && electron-builder",
    "dist:dir": "pnpm run build && electron-builder --dir",
    "screenshot": "bash scripts/capture.sh",
    "package:linux": "electron-builder --linux AppImage --x64 --publish never",
    "package:windows": "electron-builder --win nsis --x64 --publish never",
    "package:macos": "electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:linux": "pnpm run build && pnpm run package:linux",
    "dist:windows": "pnpm run build && pnpm run package:windows",
    "dist:macos": "pnpm run build && pnpm run package:macos"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.nocturne.chess",
    "productName": "Nocturne Chess",
    "copyright": "Copyright © 2026 Nocturne Atelier",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/web/dist",
        "to": "web"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "3D chess atelier",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.board-games"
    },
    "artifactName": "nocturne-chess-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nocturne Chess",
      "deleteAppDataOnUninstall": false
    }
  },
  "packageManager": "pnpm@12.11.2",
  "desktopName": "nocturne-chess.desktop",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  }
}
